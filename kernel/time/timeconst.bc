/* SPDX-License-Identifier: GPL-2.0 */

/*
 * 构建期数据流：Kbuild 把配置得到的 HZ 作为标准输入交给本 bc 程序；程序用任意精度整数运算
 * 预先求出 jiffy 与毫秒/微秒/纳秒之间的乘数、舍入补偿和移位，再把 C 宏写到
 * include/generated/timeconst.h。运行时转换因此只需整数乘加和移位，不必执行昂贵除法。
 *
 * bc 的 scale 控制除法保留的小数位数。设为 0 表示所有除法均做整数截断；脚本在需要向上取整
 * 时显式加入 d-1，避免结果依赖 bc 的默认精度。此文件只在构建主机执行，没有内核并发、锁、
 * 对象 ownership 或运行期失败回滚。
 */
scale=0

/*
 * gcd() - 用欧几里得算法计算两个正整数的最大公约数。
 *
 * 【调用位置】fadj() 用它消去比例 n/d 的公因子；timeconst() 用它生成最简 NUM/DEN 宏。
 * 【参数】a、b 是纯输入整数；调用点传入 HZ 与 10^3/10^6/10^9，均为正数。函数不保存输入。
 * 【局部变量】t 暂存旧 b，使 a、b 可更新为 (b, a mod b) 而不丢失被除数。
 * 【返回】b 归零时 a 是最大公约数；无输出参数和外部副作用，不会睡眠或失败。
 */
define gcd(a,b) {
	auto t;
	/* 每轮严格缩小非零余数，最终以最后一个非零除数结束。 */
	while (b) {
		t = b;
		b = a % b;
		a = t;
	}
	return a;
}

/* Division by reciprocal multiplication. */
/*
 * 把“以倒数乘法代替除法”的英文原意落到公式：返回 ceil(2^b * n / d)，作为 b 位定点倒数乘数。
 * 向上取整保证后续右移不会系统性低估；边界误差再由 fadj() 产生的补偿量控制。
 */
/*
 * fmul() - 计算 n/d 的 b 位定点向上取整乘数。
 *
 * @b 是二进制缩放位数，@n/@d 是正整数分子和分母且 d 非零；均为借用纯输入值。
 * 调用者 fmuls()/timeconst() 把结果写入生成宏。返回 ceil(2^b*n/d)，无外部副作用、锁或失败路径。
 */
define fmul(b,n,d) {
       return (2^b*n+d-1)/d;
}

/* Adjustment factor when a ceiling value is used.  Use as:
   (imul * n) + (fmulxx * n + fadjxx) >> xx) */
/*
 * 使用向上取整乘数时需要的补偿因子；生成代码按上式把整数部分与定点小数部分合并后右移。
 * 补偿把 ceil 倒数带来的偏差约束到预期舍入规则，而不是简单地让所有结果偏大。
 */
/*
 * fadj() - 为向上取整的 b 位定点乘数计算配套 adjustment。
 *
 * @b、@n、@d 与 fmul() 含义相同，d 必须非零。d 是 bc 形参的局部副本，约分不会改变调用者。
 * v 保存 2^b*(d-1)/d 的截断值。返回补偿常量；无外部状态、ownership 或失败副作用。
 */
define fadj(b,n,d) {
	auto v;
	/* 先按 gcd(n,d) 约去比例公因子；补偿周期只由最简分母决定。 */
	d = d/gcd(n,d);
	v = 2^b*(d-1)/d;
	return v;
}

/* Compute the appropriate mul/adj values as well as a shift count,
   which brings the mul value into the range 2^b-1 <= x < 2^b.  Such
   a shift value will be correct in the signed integer range and off
   by at most one in the upper half of the unsigned range. */
/*
 * 计算适合的乘数/补偿参数所需移位，使乘数进入 2^(b-1) <= x < 2^b 的规格化范围。
 * 该移位在有符号整数范围内正确；在无符号范围上半部最多相差 1。这里返回 shift，调用者再用
 * 同一个 shift 调 fmul()/fadj()，三者必须作为一组使用，不能混配不同缩放位数。
 */
/*
 * fmuls() - 搜索让定点乘数占满目标 b 位有效范围的最小 shift。
 *
 * @b 是目标乘数宽度，@n/@d 是正比例。s 为候选移位，m 为对应向上取整乘数。
 * 循环从 0 单调增加，比例为正时必会达到阈值并返回；尾部 return 仅满足 bc 函数结构，不可达。
 */
define fmuls(b,n,d) {
	auto s, m;
	/* 首个达到半宽阈值的 s 同时保留精度并避免乘数越出 b 位设计范围。 */
	for (s = 0; 1; s++) {
		m = fmul(s,n,d);
		if (m >= 2^(b-1))
			return s;
	}
	return 0;
}

/*
 * timeconst() - 为一个构建期 HZ 生成完整的 timeconst.h。
 *
 * 【入口与参数】@hz 是 read() 从标准输入取得的每秒 jiffy 数，纯整数值；有效配置要求 hz >= 2。
 * 本函数在构建主机的单线程 bc 解释器中运行，不持锁、不会睡眠，也不持有内核对象。
 *
 * 【变量地图】
 *   s      当前转换方向选出的定点右移位数；随后同值传给 fmul/fadj。
 *   cd     HZ 与目标单位每秒刻度数的最大公约数，用来输出最简有理数。
 *   obase  bc 的全局输出进制；乘数/补偿切到十六进制，shift 和 NUM/DEN 切回十进制。
 * bc 未用 auto 声明的名字具有全局动态作用域，但脚本只调用 timeconst() 一次，故不会并发污染。
 *
 * 【输出与失败】通过 print 向标准输出写头文件，不返回业务值。hz < 2 时仍生成含 #error 的头，
 * 让后续 C 编译明确失败；正常路径写 include guard、配置一致性检查和全部转换宏，最后 halt 结束
 * 解释器。输出文本的 ownership 交给重定向该标准输出的 Kbuild 规则。
 */
define timeconst(hz) {
	/* 阶段 1：写生成来源、HZ 身份和 include guard，使陈旧头文件在编译期可被识别。 */
	print "/* Automatically generated by kernel/time/timeconst.bc */\n"
	print "/* Time conversion constants for HZ == ", hz, " */\n"
	print "\n"

	print "#ifndef KERNEL_TIMECONST_H\n"
	print "#define KERNEL_TIMECONST_H\n\n"

	print "#include <linux/param.h>\n"
	print "#include <linux/types.h>\n\n"

	print "#if HZ != ", hz, "\n"
	print "#error \qinclude/generated/timeconst.h has the wrong HZ value!\q\n"
	print "#endif\n\n"

	/* 阶段 2：拒绝没有实际计时意义的频率；错误被编码进生成头而不是依赖 bc 返回码。 */
	if (hz < 2) {
		print "#error Totally bogus HZ value!\n"
	} else {
		/*
		 * 阶段 3：生成 jiffy -> millisecond 的定点三元组 MUL/ADJ/SHR。
		 * s 先规格化 32 位乘数；十六进制便于 C 端核对位模式，shift 保持十进制可读。
		 */
		s=fmuls(32,1000,hz)
		obase=16
		print "#define HZ_TO_MSEC_MUL32\tU64_C(0x", fmul(s,1000,hz), ")\n"
		print "#define HZ_TO_MSEC_ADJ32\tU64_C(0x", fadj(s,1000,hz), ")\n"
		obase=10
		print "#define HZ_TO_MSEC_SHR32\t", s, "\n"

		/* 交换分子/分母，按相同协议生成 millisecond -> jiffy 的向上舍入快速路径。 */
		s=fmuls(32,hz,1000)
		obase=16
		print "#define MSEC_TO_HZ_MUL32\tU64_C(0x", fmul(s,hz,1000), ")\n"
		print "#define MSEC_TO_HZ_ADJ32\tU64_C(0x", fadj(s,hz,1000), ")\n"
		obase=10
		print "#define MSEC_TO_HZ_SHR32\t", s, "\n"

		/*
		 * 同时输出最简精确比例，供不适合定点快速式的调用点使用；正反方向共享 cd，
		 * NUM/DEN 对调后仍代表同一有理数，不引入额外舍入。
		 */
		obase=10
		cd=gcd(hz,1000)
		print "#define HZ_TO_MSEC_NUM\t\t", 1000/cd, "\n"
		print "#define HZ_TO_MSEC_DEN\t\t", hz/cd, "\n"
		print "#define MSEC_TO_HZ_NUM\t\t", hz/cd, "\n"
		print "#define MSEC_TO_HZ_DEN\t\t", 1000/cd, "\n"
		print "\n"

		/* 阶段 4：把目标刻度换为每秒 10^6，重复生成 jiffy <-> microsecond 定点三元组。 */
		s=fmuls(32,1000000,hz)
		obase=16
		print "#define HZ_TO_USEC_MUL32\tU64_C(0x", fmul(s,1000000,hz), ")\n"
		print "#define HZ_TO_USEC_ADJ32\tU64_C(0x", fadj(s,1000000,hz), ")\n"
		obase=10
		print "#define HZ_TO_USEC_SHR32\t", s, "\n"

		/* microsecond -> jiffy 使用反向比例；仍以 32 位乘数加 adjustment 保证边界舍入。 */
		s=fmuls(32,hz,1000000)
		obase=16
		print "#define USEC_TO_HZ_MUL32\tU64_C(0x", fmul(s,hz,1000000), ")\n"
		print "#define USEC_TO_HZ_ADJ32\tU64_C(0x", fadj(s,hz,1000000), ")\n"
		obase=10
		print "#define USEC_TO_HZ_SHR32\t", s, "\n"

		/* 输出微秒精确比例；在进行除法前约分可降低中间乘法溢出的风险。 */
		obase=10
		cd=gcd(hz,1000000)
		print "#define HZ_TO_USEC_NUM\t\t", 1000000/cd, "\n"
		print "#define HZ_TO_USEC_DEN\t\t", hz/cd, "\n"
		print "#define USEC_TO_HZ_NUM\t\t", hz/cd, "\n"
		print "#define USEC_TO_HZ_DEN\t\t", 1000000/cd, "\n"

		/*
		 * 纳秒这里只输出最简 NUM/DEN，不生成 32 位定点三元组；C 端可按具体位宽与调用场景
		 * 使用该精确比例。10^9 是一秒的纳秒数，正反四个宏仍成对互为倒数。
		 */
		cd=gcd(hz,1000000000)
		print "#define HZ_TO_NSEC_NUM\t\t", 1000000000/cd, "\n"
		print "#define HZ_TO_NSEC_DEN\t\t", hz/cd, "\n"
		print "#define NSEC_TO_HZ_NUM\t\t", hz/cd, "\n"
		print "#define NSEC_TO_HZ_DEN\t\t", 1000000000/cd, "\n"
		print "\n"

		/* 阶段 5：只在合法 HZ 路径闭合 guard；非法路径保留未闭合文本也已先触发明确 #error。 */
		print "#endif /* KERNEL_TIMECONST_H */\n"
	}
	/* 脚本的唯一产物已经写完，显式 halt 防止解释器继续等待输入。 */
	halt
}

/* 顶层入口：read() 消费 Kbuild 写入标准输入的一个 HZ 数值，随后只生成一次头文件。 */
hz = read();
timeconst(hz)
