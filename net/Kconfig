# 轻量隧道把封装状态挂在 FIB route/nexthop 上，不创建独立 net_device，适合 MPLS 等按路由动作。
config LWTUNNEL
	bool "Network light weight tunnels"
	help
	  This feature provides an infrastructure to support light weight
	  tunnels like mpls. There is no netdevice associated with a light
	  weight tunnel endpoint. Tunnel encapsulation parameters are stored
	  with light weight tunnel state associated with fib routes.
	  轻量隧道为 MPLS 等封装提供基础设施：端点没有对应 net_device，封装参数保存在与 FIB 路由
	  关联的 lwtunnel state 中，因此生命周期随路由状态而不是虚拟网卡管理。

# 在路由查找得到 nexthop 后执行 BPF 动作；必须同时有 lwtunnel 和 INET，lwtunnel 内建时默认开启。
config LWTUNNEL_BPF
	bool "Execute BPF program as route nexthop action"
	depends on LWTUNNEL && INET
	default y if LWTUNNEL=y
	help
	  Allows to run BPF programs as a nexthop action following a route
	  lookup for incoming and outgoing packets.
	  允许入站或出站报文完成路由查找后，把 BPF 程序作为下一跳动作执行。

# 下列无 prompt 的 bool 是可复用核心组件能力：目的缓存、GRO cell、socket 发包验证和 802.1Q
# helper 均由真实消费者 select；默认 n 可避免没有调用者时把死代码带入构建。
config DST_CACHE
	bool
	default n

config GRO_CELLS
	bool
	default n

config SOCK_VALIDATE_XMIT
	bool

config NET_IEEE8021Q_HELPERS
	bool

# 网络自测随 PHYLIB 的 y/m 形态默认启用，并要求 INET；def_tristate 会让测试与依赖保持可链接的三态。
config NET_SELFTESTS
	def_tristate PHYLIB
	depends on PHYLIB && INET

# NET_SOCK_MSG 为普通 TCP socket 或 TLS 等 ULP 提供由 BPF 处理 L7 数据的共享框架，是
# BPF_STREAM_PARSER 等功能的隐藏依赖，单独默认关闭。
config NET_SOCK_MSG
	bool
	default n
	help
	  The NET_SOCK_MSG provides a framework for plain sockets (e.g. TCP) or
	  ULPs (upper layer modules, e.g. TLS) to process L7 application data
	  with the help of BPF programs.
	  NET_SOCK_MSG 允许普通 socket（如 TCP）或上层模块 ULP（如 TLS）借助 BPF 程序处理七层应用数据。

# NET_DEVLINK 与 PAGE_POOL 都是由驱动/子系统选择的隐藏公共能力。前者提供设备管理控制面，
# 后者为接收路径提供可回收 page 池；不应把隐藏默认 n 误解为功能已废弃。
config NET_DEVLINK
	bool
	default n

config PAGE_POOL
	bool

config PAGE_POOL_STATS
	default n
	bool "Page pool stats"
	depends on PAGE_POOL
	help
	  Enable page pool statistics to track page allocation and recycling
	  in page pools. This option incurs additional CPU cost in allocation
	  and recycle paths and additional memory cost to store the statistics.
	  These statistics are only available if this option is enabled and if
	  the driver using the page pool supports exporting this data.

	  If unsure, say N.
	  开启后统计 page_pool 的页面分配与回收，但会增加热路径 CPU 成本及统计存储内存；只有使用
	  page_pool 且实现导出的驱动才能提供这些数据。不确定时选 N。

# 通用 failover 让半虚拟网卡注册主 netdev 与事件操作表，并把同 MAC 的 PCI VF 作为低延迟
# 加速数据面；VF 拔除或虚机迁移时退回半虚拟路径，因此可同时获得直通性能与迁移能力。
config FAILOVER
	tristate "Generic failover module"
	help
	  The failover module provides a generic interface for paravirtual
	  drivers to register a netdev and a set of ops with a failover
	  instance. The ops are used as event handlers that get called to
	  handle netdev register/unregister/link change/name change events
	  on slave pci ethernet devices with the same mac address as the
	  failover netdev. This enables paravirtual drivers to use a
	  VF as an accelerated low latency datapath. It also allows live
	  migration of VMs with direct attached VFs by failing over to the
	  paravirtual datapath when the VF is unplugged.
	  该模块为半虚拟驱动提供统一接口，用于注册 failover netdev 与事件回调；同 MAC 的从属 PCI
	  以太网设备发生注册、注销、链路或改名事件时调用这些回调。VF 可作为低延迟加速路径，拔除
	  VF 时切回半虚拟路径，从而支持带直通 VF 的虚机在线迁移。

# generic netlink 版 ethtool 控制面比传统 ioctl 更易扩展，并支持通知等新能力；DIMLIB 是其
# 动态中断合并等实现依赖。默认 Y 不代表必须安装用户态 ethtool，但决定内核是否接受该接口。
config ETHTOOL_NETLINK
	bool "Netlink interface for ethtool"
	select DIMLIB
	default y
	help
	  An alternative userspace interface for ethtool based on generic
	  netlink. It provides better extensibility and some new features,
	  e.g. notification messages.
	  这是基于 generic netlink 的 ethtool 替代用户接口，扩展性更好，并提供通知消息等新功能。

# 两项 KUnit 配置只增加测试对象：前者验证 net_device 地址列表，后者覆盖 sk_buff 等网络核心设施。
# KUNIT_ALL_TESTS 统一提供默认值；生产配置或不确定时应选 N。
config NETDEV_ADDR_LIST_TEST
	tristate "Unit tests for device address list"
	default KUNIT_ALL_TESTS
	depends on KUNIT

config NET_TEST
	tristate "KUnit tests for networking" if !KUNIT_ALL_TESTS
	depends on KUNIT
	default KUNIT_ALL_TESTS
	help
	  KUnit tests covering core networking infra, such as sk_buff.

	  If unsure, say N.
	  运行覆盖 sk_buff 等网络核心基础设施的 KUnit 测试；不确定时选 N。

endif   # if NET
# 该 endif 与开头的 if NET 配对：NET=n 时本文件中所有协议、网络测试和公共能力均不进入配置域。
