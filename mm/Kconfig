config PTE_MARKER_UFFD_WP
# 用 marker PTE 在 shmem/HugeTLB 等无普通 present PTE 的场景保存 UFFD-WP 状态。
	bool "Userfaultfd write protection support for shmem/hugetlbfs"
	default y
	depends on HAVE_ARCH_USERFAULTFD_WP

	help
	  Allows to create marker PTEs for userfaultfd write protection
	  purposes.  It is required to enable userfaultfd write protection on
	  file-backed memory types like shmem and hugetlbfs.
endif # USERFAULTFD

# multi-gen LRU {
# Multi-Gen LRU 用访问代际替代传统 active/inactive 近似，提高过量分配下的回收质量。
config LRU_GEN
	bool "Multi-Gen LRU"
	depends on MMU
	# make sure folio->flags has enough spare bits
	# folio->flags 必须有足够空闲位保存代际状态；64 位或 vmemmap 布局满足约束。
	depends on 64BIT || !SPARSEMEM || SPARSEMEM_VMEMMAP
	help
	  A high performance LRU implementation to overcommit memory. See
	  Documentation/admin-guide/mm/multigen_lru.rst for details.

config LRU_GEN_ENABLED
# 只决定启动默认，运行期仍可切换 Multi-Gen LRU。
	bool "Enable by default"
	depends on LRU_GEN
	help
	  This option enables the multi-gen LRU by default.

config LRU_GEN_STATS
# 保留被淘汰代际的完整历史统计，按 memcg/node 增加内存，只适合调试。
	bool "Full stats for debugging"
	depends on LRU_GEN
	help
	  Do not enable this option unless you plan to look at historical stats
	  from evicted generations for debugging purpose.

	  This option has a per-memcg and per-node memory overhead.

config LRU_GEN_WALKS_MMU
# 架构硬件维护 PTE young 位时，MGLRU 可通过遍历页表收集访问热度。
	def_bool y
	depends on LRU_GEN && ARCH_HAS_HW_PTE_YOUNG
# }

config ARCH_SUPPORTS_PER_VMA_LOCK
# 架构声明 page-fault 快路径与页表协议兼容 per-VMA 锁。
       def_bool n

config PER_VMA_LOCK
# SMP MMU 下用单 VMA 锁处理部分页故障，避免争用整个 mmap_lock；失败/变化时仍
# 需回退到 mm 级锁并重新验证 VMA 生命周期。
	def_bool y
	depends on ARCH_SUPPORTS_PER_VMA_LOCK && MMU && SMP
	help
	  Allow per-vma locking during page fault handling.

	  This feature allows locking each virtual memory area separately when
	  handling page faults instead of taking mmap_lock.

config LOCK_MM_AND_FIND_VMA
# 向下增长栈架构可使用合并的 mmap 锁定与 VMA 查找 helper。
	bool
	depends on !STACK_GROWSUP

config IOMMU_MM_DATA
# mm_struct 携带 IOMMU 相关进程地址空间数据的内部能力。
	bool

config EXECMEM
# 架构使用通用可执行内存分配层，mm/Makefile 据此链接 execmem.o。
	bool

config NUMA_MEMBLKS
# 使用通用 NUMA memblock 拓扑解析；NUMA_EMU 依赖它改写节点范围。
	bool

config NUMA_EMU
# 调试时用 numa=fake=N 把平坦机器切成虚拟节点，不代表硬件拓扑真实变化。
	bool "NUMA emulation"
	depends on NUMA_MEMBLKS
	depends on X86 || GENERIC_ARCH_NUMA
	help
	  Enable NUMA emulation. A flat machine will be split
	  into virtual nodes when booted with "numa=fake=N", where N is the
	  number of nodes. This is only useful for debugging.

config ARCH_HAS_USER_SHADOW_STACK
# 架构具有用户 shadow stack 硬件（如 CET/GCS/Zicfiss），通用 MM 据此处理映射属性。
	bool
	help
	  The architecture has hardware support for userspace shadow call
	  stacks (eg, x86 CET, arm64 GCS or RISC-V Zicfiss).

config HAVE_ARCH_TLB_REMOVE_TABLE
# 架构自带页表页回收 hook 时选择，通用 PT_RECLAIM 不再重复实现。
	def_bool n

config PT_RECLAIM
# 在 munmap/exit_mmap 之外也尝试回收空用户 PTE 页；要求 RCU table free，且只在
# 架构没有自定义 remove_table 时启用。
	def_bool y
	depends on MMU_GATHER_RCU_TABLE_FREE && !HAVE_ARCH_TLB_REMOVE_TABLE
	help
	  Try to reclaim empty user page table pages in paths other than munmap
	  and exit_mmap path.

	  Note: now only empty user PTE page table pages will be reclaimed.

config FIND_NORMAL_PAGE
# 架构/子系统需要把特殊映射解析为普通 page 的内部能力开关。
	def_bool n

config ARCH_HAS_LAZY_MMU_MODE
# lazy MMU mode 把一批架构页表状态更新延后到退出模式时提交，减少昂贵同步。
	bool
	help
	  The architecture uses the lazy MMU mode. This allows changes to
	  MMU-related architectural state to be deferred until the mode is
	  exited. See <linux/pgtable.h> for details.

config LAZY_MMU_MODE_KUNIT_TEST
# 只验证通用 lazy MMU 接口契约，不覆盖架构具体行为；依赖能力与 KUnit 框架。
	tristate "KUnit tests for the lazy MMU mode" if !KUNIT_ALL_TESTS
	depends on ARCH_HAS_LAZY_MMU_MODE
	depends on KUNIT
	default KUNIT_ALL_TESTS
	help
	  Enable this option to check that the lazy MMU mode interface behaves
	  as expected. Only tests for the generic interface are included (not
	  architecture-specific behaviours).

	  If unsure, say N.

source "mm/damon/Kconfig"
# 在同一 Memory Management 菜单内继续解析 DAMON 子系统配置，符号随后驱动
# mm/damon/Makefile 的 core、ops、sysfs 与策略模块组合。

endmenu
